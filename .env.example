# Copy this file to `.env` and fill in the values, then:  docker compose up -d
#
# ============================================================================
# Email + SMS via Brevo (https://www.brevo.com) — recommended, free tier.
#   Email: 300 emails/day free.  SMS: transactional API (needs SMS credits;
#   Brevo gives a small amount of free trial SMS credit to start).
#   1. Create a free Brevo account.
#   2. Verify a sender email (Senders & IP > Senders) and put it in BREVO_SENDER_EMAIL.
#   3. Create an API key (SMTP & API > API Keys) and put it in BREVO_API_KEY.
# ============================================================================
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=youraddress@example.com
BREVO_SENDER_NAME=Travel Easy
# SMS sender ID (alphanumeric, max 11 chars). Some countries require registration.
BREVO_SMS_SENDER=TravelEasy

# ----------------------------------------------------------------------------
# Fallback A — Gmail SMTP (email only). Used if Brevo is not set.
#   Needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM=Travel Easy <youraddress@gmail.com>

# Fallback B — Resend (email only, sender-domain limited on the free plan).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_FROM=Travel Easy <onboarding@resend.dev>

# --- Other optional overrides (safe defaults exist in docker-compose.yml) ---
# JWT_SECRET=change-me-in-production
# CORS_ORIGIN=http://localhost:5173
